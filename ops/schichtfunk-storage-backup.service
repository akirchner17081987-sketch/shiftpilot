[Unit]
Description=SchichtFunk encrypted Storage backup and restore verification
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=schichtfunk-backup
Group=schichtfunk-backup
UMask=0077
EnvironmentFile=/etc/schichtfunk/storage-backup.env
ExecStart=/usr/bin/node /opt/schichtfunk/scripts/storage-backup.mjs backup
WorkingDirectory=/opt/schichtfunk
RuntimeDirectory=schichtfunk-backup
RuntimeDirectoryMode=0700
StateDirectory=schichtfunk-backup
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/schichtfunk-backup /var/lib/schichtfunk-backup
TimeoutStartSec=3h
