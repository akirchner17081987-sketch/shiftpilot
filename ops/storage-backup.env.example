# Configure these as Supabase Edge Function secrets (never frontend variables).
# No real keys or production bucket names belong in Git.
BACKUP_DISPATCH_TOKEN=
BACKUP_MASTER_KEY_B64=
BACKUP_S3_ENDPOINT=https://s3.eu-central-1.ionoscloud.com
BACKUP_S3_REGION=eu-central-1
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=schichtfunk/v1
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# Only for independent restore; Supabase supplies its URL/service key to Edge.
BACKUP_PROJECT_REF=
# SUPABASE_SERVICE_ROLE_KEY must NOT be supplied to the restore process.
# Store the same BACKUP_DISPATCH_TOKEN in Vault under storage_backup_dispatch_token.
# Migration remains disabled until target capability test and monitor are ready.
