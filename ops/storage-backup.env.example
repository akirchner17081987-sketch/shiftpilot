# SERVER ONLY. Copy outside the repository, owner backup user, mode 0600.
# Source keys are privileged Supabase S3 keys and bypass RLS. Never use in the browser.
SF_BACKUP_PROJECT_REF=replace_with_project_ref
SF_BACKUP_SOURCE_REGION=eu-central-1
SF_BACKUP_BUCKET=personnel-documents
SF_BACKUP_SOURCE_ACCESS_KEY_ID=replace_in_private_file
SF_BACKUP_SOURCE_SECRET_ACCESS_KEY=replace_in_private_file

# Independent, approved EU S3 provider; example only, not provisioned.
RESTIC_REPOSITORY=s3:https://replace-with-approved-s3-endpoint/replace-with-private-backup-bucket/storage
AWS_DEFAULT_REGION=replace_with_destination_region
AWS_ACCESS_KEY_ID=replace_in_private_file
AWS_SECRET_ACCESS_KEY=replace_in_private_file
RESTIC_PASSWORD_FILE=/etc/schichtfunk/backup-password

SF_BACKUP_WORK_ROOT=/run/schichtfunk-backup
SF_BACKUP_STATE_ROOT=/var/lib/schichtfunk-backup
SF_BACKUP_MAX_BYTES=1073741824
SF_BACKUP_MAX_AGE_HOURS=26
# Set true only for a deliberately empty bucket. An empty source after non-empty
# successful snapshots is always rejected; resolve the incident before restarting.
SF_BACKUP_ALLOW_EMPTY=false
